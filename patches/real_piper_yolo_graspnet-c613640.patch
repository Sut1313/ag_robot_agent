@@ -0,0 +1,86 @@
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from real_piper_perception.real_hold_place import RealHoldPlace
+
+
+def make_cycle(monkeypatch, openings, motion=True):
+    monkeypatch.setattr('real_piper_perception.real_hold_place.FEEDBACK_SETTLE_S', 0)
+    gripper = Mock()
+    gripper.params = {'velocity_scale': 0.02, 'planning_time_exec': 1.0}
+    gripper._read_gripper_feedback_stable.side_effect = openings
+    arm = gripper.move_group
+    arm.hardware_joints.return_value = {f'joint{i}': 0.0 for i in range(1, 7)}
+    planned_start = {}
+
+    def set_start(joints):
+        planned_start.update(joints)
+
+    def plan():
+        pos = list(planned_start.values())
+        points = [
+            SimpleNamespace(positions=pos, time_from_start=SimpleNamespace(sec=sec, nanosec=0))
+            for sec in (0, 1)
+        ]
+        trajectory = SimpleNamespace(joint_names=list(planned_start), points=points)
+        return SimpleNamespace(trajectory=SimpleNamespace(joint_trajectory=trajectory))
+
+    arm.set_planning_start.side_effect = set_start
+    arm.plan.side_effect = plan
+    arm.compute_cartesian_path.side_effect = lambda *args, **kwargs: (plan(), 1.0)
+    cycle = RealHoldPlace(gripper, motion, [0.0] * 6)
+    cycle.prepare('block_0', {
+        'grasp': {'pos': [0.3, 0.0, 0.04]},
+        'lift': {'pos': [0.3, 0.0, 0.09]},
+    }, [0.3, 0.0, 0.04])
+    return cycle, arm, gripper
+
+
+def test_pick_holds_until_a_separate_place_request(monkeypatch):
+    cycle, arm, gripper = make_cycle(
+        monkeypatch, [0.07, 0.004, 0.07, 0.04, 0.04, 0.04, 0.04, 0.07])
+    arm.execute.assert_not_called()
+    gripper._gripper_set_width.assert_not_called()
+
+    assert cycle.pick()['state'] == 'held'
+    assert arm.execute.call_count == 3
+    assert gripper._gripper_set_width.call_args.args[0] == 0.0
+    with pytest.raises(RuntimeError, match='prepared'):
+        cycle.pick()
+
+    result = cycle.place()
+    assert result['state'] == 'placed' and result['released']
+    assert arm.execute.call_count == 6
+    assert gripper._gripper_set_width.call_args.args[0] == 0.07
+
+
+def test_zero_feedback_and_disabled_motion_cannot_move_the_arm(monkeypatch):
+    cycle, arm, gripper = make_cycle(monkeypatch, [], motion=False)
+    with pytest.raises(RuntimeError, match='尚未启用'):
+        cycle.pick()
+    gripper._gripper_set_width.assert_not_called()
+    arm.execute.assert_not_called()
+
+    cycle, arm, gripper = make_cycle(monkeypatch, [0.0])
+    with pytest.raises(RuntimeError, match='全开反馈无效'):
+        cycle.pick()
+    arm.execute.assert_not_called()
+    assert gripper._gripper_set_width.call_count == 1
+
+
+def test_cancel_during_lowering_cannot_open_the_gripper(monkeypatch):
+    cycle, arm, gripper = make_cycle(
+        monkeypatch, [0.07, 0.004, 0.07, 0.04, 0.04, 0.04])
+    assert cycle.pick()['state'] == 'held'
+
+    def stop(plan, cancel_event):
+        cancel_event.set()
+        return False
+
+    arm.execute.side_effect = stop
+    with pytest.raises(RuntimeError, match='lower'):
+        cycle.place()
+    assert not cycle.released
+    assert gripper._gripper_set_width.call_args.args[0] == 0.0
