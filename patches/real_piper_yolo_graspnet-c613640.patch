@@ -0,0 +1,251 @@
+"""One opt-in PiPER cycle, with a separate command for returning the object."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+import math
+import threading
+import time
+import uuid
+
+from .grasp_execute import (
+    END_EFFECTOR_LINK,
+    FEEDBACK_SETTLE_S,
+    GraspExecutor,
+    gripper_calibration_is_valid,
+)
+from .grasp_verify import OPEN_TOL, classify_grasp
+
+
+@dataclass
+class Preview:
+    id: str
+    candidate: str
+    expires_at: float
+    center_camera: tuple
+    pick_position_m: tuple
+    lift_height_m: float
+    pick: list
+    place: list
+
+
+class RealHoldPlace:
+    JOINT_TOL_RAD = 0.02
+    MAX_FRAME_AGE_S = 20.0
+    PREVIEW_TTL_S = 90.0
+
+    def __init__(self, executor: GraspExecutor, motion_enabled: bool, zero: list):
+        self.executor = executor
+        self.arm = executor.move_group
+        self.motion_enabled = motion_enabled
+        self.zero = dict(zip((f'joint{i}' for i in range(1, 7)), zero))
+        self.cancel = threading.Event()
+        self.preview: Preview | None = None
+        self.state = 'idle'
+        self.stage = ''
+        self.opening = None
+        self.released = False
+        self._reference: tuple[float, float] | None = None
+        self._held_width: float | None = None
+        self.arm.enable_hardware_feedback()
+
+    def status(self) -> dict:
+        preview = self.preview
+        remaining = preview.expires_at - time.monotonic() if preview else 0.0
+        state = 'expired' if self.state == 'prepared' and remaining <= 0 else self.state
+        return {
+            'success': True, 'state': state, 'stage': self.stage,
+            'preview_id': preview.id if preview else None,
+            'candidate': preview.candidate if preview else None,
+            'pick_position_m': preview.pick_position_m if preview else None,
+            'lift_height_m': preview.lift_height_m if preview else None,
+            'approval_remaining_s': round(max(0.0, remaining), 1) if state == 'prepared' else None,
+            'motion_enabled': self.motion_enabled,
+            'stop_requested': self.cancel.is_set(),
+            'opening_m': self.opening, 'released': self.released,
+        }
+
+    def check_frame(self, csv_path: str) -> int:
+        modified = Path(csv_path).stat().st_mtime_ns
+        if not 0 <= time.time() - modified / 1e9 <= self.MAX_FRAME_AGE_S:
+            raise RuntimeError('抓取候选已过期，请更新感知后再预演')
+        return modified
+
+    def _match(self, expected: dict, stage: str) -> None:
+        actual = self.arm.hardware_joints()
+        if any(abs(actual[name] - value) > self.JOINT_TOL_RAD
+               for name, value in expected.items()):
+            raise RuntimeError(f'{stage}：真机关节位置与预演不一致')
+
+    def _plan(self, start: dict, label: str, pose: dict | None = None,
+              *, cartesian: bool = False):
+        self.arm.set_planning_start(start)
+        if pose is None:
+            self.arm.set_joint_value_target(self.zero)
+            plan = self.arm.plan()
+        else:
+            link_pose = self.executor._make_pose_msg(self.executor._tcp_pose_to_link6(pose))
+            if cartesian:
+                plan, fraction = self.arm.compute_cartesian_path(
+                    [link_pose], eef_step=0.005, jump_threshold=1.5, avoid_collisions=True)
+                if not math.isfinite(fraction) or fraction < 1.0 - 1e-9:
+                    raise RuntimeError(f'{label}：笛卡尔路径不完整')
+            else:
+                self.arm.set_pose_target(link_pose, end_effector_link=END_EFFECTOR_LINK)
+                plan = self.arm.plan()
+        if plan is None:
+            raise RuntimeError(f'{label}：规划失败')
+        trajectory = plan.trajectory.joint_trajectory
+        names = list(trajectory.joint_names)
+        points = trajectory.points
+        if len(names) != len(start) or set(names) != set(start) or len(points) < 2:
+            raise RuntimeError(f'{label}：轨迹关节或点数异常')
+        previous = start
+        previous_time = -1.0
+        for point in points:
+            current = dict(zip(names, point.positions))
+            stamp = point.time_from_start.sec + point.time_from_start.nanosec * 1e-9
+            tolerance = self.JOINT_TOL_RAD if previous is start else 0.20
+            if (len(point.positions) != len(names) or stamp <= previous_time
+                    or not all(math.isfinite(value) for value in current.values())
+                    or any(abs(current[name] - previous[name]) > tolerance for name in names)):
+                raise RuntimeError(f'{label}：轨迹时间或关节连续性异常')
+            previous, previous_time = current, stamp
+        return (label, plan, dict(start), previous)
+
+    def prepare(self, candidate: str, poses: dict, center_camera) -> dict:
+        state = self.status()['state']
+        if state not in {'idle', 'placed', 'expired'}:
+            raise RuntimeError(f'当前状态 {state} 无法开始新预演')
+        self._match(self.zero, '预演起点')
+        start = self.arm.hardware_joints()
+        scale = float(self.executor.params['velocity_scale'])
+        if not 0 < scale <= 0.05:
+            raise RuntimeError('真机速度缩放必须在 0 至 0.05 之间')
+        self.arm.set_max_velocity_scaling_factor(scale)
+        self.arm.set_planning_time(float(self.executor.params['planning_time_exec']))
+        try:
+            grasp, lift = poses['grasp'], poses['lift']
+            # The lift and return follow the same vertical line. Release at
+            # the original supported grasp height before retreating.
+            clearance = lift['pos'][2] - grasp['pos'][2]
+            if not 0.02 <= clearance <= 0.06:
+                raise RuntimeError('抬升高度须为 20 至 60 mm')
+            approach = self._plan(start, 'approach', lift)
+            descend = self._plan(approach[3], 'grasp', grasp, cartesian=True)
+            raise_object = self._plan(descend[3], 'lift', lift, cartesian=True)
+            lower = self._plan(raise_object[3], 'lower', grasp, cartesian=True)
+            if any(abs(lower[3][name] - value) > self.JOINT_TOL_RAD
+                   for name, value in descend[3].items()):
+                raise RuntimeError('放回路径未返回原抓取关节位姿')
+            retreat = self._plan(lower[3], 'retreat', lift, cartesian=True)
+            home = self._plan(retreat[3], 'home')
+            if any(abs(home[3][name] - value) > self.JOINT_TOL_RAD
+                   for name, value in self.zero.items()):
+                raise RuntimeError('回零轨迹终点不符合零位')
+        finally:
+            self.arm.set_start_state_to_current_state()
+        self.preview = Preview(uuid.uuid4().hex, candidate,
+                               time.monotonic() + self.PREVIEW_TTL_S,
+                               tuple(float(value) for value in center_camera),
+                               tuple(grasp['pos']), clearance,
+                               [approach, descend, raise_object], [lower, retreat, home])
+        self.state, self.stage, self.released = 'prepared', 'planned', False
+        self.opening = self._reference = self._held_width = None
+        return self.status()
+
+    def _check_cancel(self) -> None:
+        if self.cancel.is_set():
+            raise RuntimeError('已请求停止')
+
+    def _move(self, segment) -> None:
+        self.stage, plan, start, end = segment
+        self._check_cancel()
+        self._match(start, self.stage)
+        if not self.arm.execute(plan, cancel_event=self.cancel):
+            raise RuntimeError(f'{self.stage}：轨迹未完成')
+        self._check_cancel()
+        deadline = time.monotonic() + 1.0
+        while True:
+            self._check_cancel()
+            try:
+                self._match(end, self.stage)
+                break
+            except RuntimeError:
+                if time.monotonic() >= deadline:
+                    raise
+                time.sleep(0.05)
+
+    def _gripper(self, target: float, label: str) -> float:
+        self._check_cancel()
+        self.arm.hardware_joints()
+        if not self.executor._gripper_set_width(target, label):
+            raise RuntimeError(f'{label}夹爪命令失败')
+        self._check_cancel()
+        time.sleep(FEEDBACK_SETTLE_S)
+        return self._read_opening()
+
+    def _read_opening(self) -> float:
+        opening = self.executor._read_gripper_feedback_stable()
+        self._check_cancel()
+        self.arm.hardware_joints()
+        if opening is None or not 0 <= opening <= 0.075:
+            raise RuntimeError('未收到有效、稳定的夹爪反馈')
+        self.opening = opening
+        return opening
+
+    def _verify_hold(self, opening: float) -> None:
+        if classify_grasp(opening, *self._reference)[0] != 'success':
+            raise RuntimeError('夹爪开度未通过持物复核')
+        if self._held_width is not None and abs(opening - self._held_width) > 0.003:
+            raise RuntimeError('夹爪开度变化超过持物容差')
+
+    def _ready(self, expected: str) -> Preview:
+        if not self.motion_enabled:
+            raise RuntimeError('当前仅允许预演，真机动作尚未启用')
+        if self.status()['state'] != expected or self.preview is None:
+            raise RuntimeError(f'当前状态不能执行此命令，需要 {expected}')
+        return self.preview
+
+    def pick(self) -> dict:
+        preview = self._ready('prepared')
+        self._check_cancel()
+        self._match(preview.pick[0][2], '抓取起点')
+        self.state, self.stage = 'picking', 'gripper_calibration'
+        full_open = self._gripper(0.07, '标定张开')
+        if not 0.060 <= full_open <= 0.075:
+            raise RuntimeError('夹爪全开反馈无效')
+        full_closed = self._gripper(0.0, '标定闭合')
+        if not gripper_calibration_is_valid(full_open, full_closed):
+            raise RuntimeError('全开及全闭参考无效')
+        self._reference = full_open, full_closed
+        if self._gripper(0.07, '预抓张开') < full_open - OPEN_TOL:
+            raise RuntimeError('预抓张开未到位')
+        self._move(preview.pick[0])
+        self._move(preview.pick[1])
+        self.stage = 'closing'
+        self._match(preview.pick[1][3], self.stage)
+        self._held_width = self._gripper(0.0, '抓取闭合')
+        self._verify_hold(self._held_width)
+        self._move(preview.pick[2])
+        self.stage = 'hold_feedback'
+        self._verify_hold(self._read_opening())
+        self.state = 'held'
+        return self.status()
+
+    def place(self) -> dict:
+        preview = self._ready('held')
+        self._check_cancel()
+        self.state, self.stage = 'placing', 'hold_feedback'
+        self._verify_hold(self._read_opening())
+        self._move(preview.place[0])
+        self.stage = 'release'
+        self._verify_hold(self._read_opening())
+        self._match(preview.place[0][3], self.stage)
+        if self._gripper(0.07, '放置张开') < self._reference[0] - OPEN_TOL:
+            raise RuntimeError('释放开度未到位')
+        self.released = True
+        for segment in preview.place[1:]:
+            self._move(segment)
+        self.state, self.stage = 'placed', 'home'
+        return self.status()
